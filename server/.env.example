# Khóa Gemini lấy từ Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Kết nối sang dịch vụ OCR cục bộ
OCR_SERVICE_URL=http://127.0.0.1:8001
OCR_INTERNAL_SECRET=dev-secret-key-123

# Môi trường chạy (development / production)
ENVIRONMENT=development
DEBUG=true

# Chrome Extension ID được phép nhận callback đăng nhập
# Điền ID của extension trong chrome://extensions (ví dụ: abcdefghijklmnopabcdefghijklmnop)
# Hoặc để * để cho phép mọi Extension trong lúc dev
ALLOWED_EXTENSION_IDS=*

# Cấu hình Firebase Auth (Dùng cho Google Sign-In & Email/Password thật)
# Lấy từ Firebase Console -> Project Settings -> General -> Your apps -> Web app config
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Cấu hình cổng thanh toán PayOS (Dùng cho tạo link QR VietQR thật)
# Lấy từ trang quản trị PayOS (https://payos.vn/)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:8000/billing/v1/payos/return
PAYOS_CANCEL_URL=http://localhost:8000/billing/v1/payos/cancel
