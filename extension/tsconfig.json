{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "entrypoints/**/*",
    "src/**/*",
    "tests/**/*",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
